# Docker Compose and local development defaults (never put real secrets here)
POSTGRES_DB=flowboard
POSTGRES_USER=flowboard
POSTGRES_PASSWORD=flowboard_local
DATABASE_URL=postgresql://flowboard:flowboard_local@localhost:5432/flowboard?schema=public
API_PORT=3000
VITE_API_BASE_URL=http://localhost:3000/v1
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
